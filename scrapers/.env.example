# ==========================================
# APP SETTINGS
# ==========================================
APP_NAME=Academic Research Scraper API
APP_VERSION=1.0.0
APP_DESCRIPTION="IEEE Xplore, ScienceDirect ve ACM'den akademik makale toplayan scraper'ları yönetir."

# Proxy Configuration
USE_PROXY=True
proxy_user=
proxy_pass=
proxy_host=proxy2.gazi.edu.tr
proxy_port=2001

# Science Direct URL
SCIENCEDIRECT_BASE_URL=https://www.sciencedirect.com/browse/journals-and-books?contentType=JL&subject=computer-science
IEEEXPLORE_BASE_URL=https://ieeexplore.ieee.org/browse/periodicals/title?contentType=periodicals&showActiveTitlesOnly=true&refinements=ContentType:Journals&rowsPerPage=100&pageNumber=1
ACM_BASE_URL=https://dl.acm.org/journals
WILEY_BASE_URL=https://onlinelibrary.wiley.com/action/showPublications?ConceptID=68&PubType=journal&startPage=0&pageSize=20
SPRINGER_BASE_URL=https://link.springer.com/brands/springer/journals/computer-science

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=academic_research

# MongoDB Authentication (optional - for production)
MONGODB_USERNAME=
MONGODB_PASSWORD=

# MongoDB Connection Settings
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=10

# Scraper Settings
SCRAPER_LOG_LEVEL=INFO
SCRAPER_LOG_FILE=logs/scraper.log

# Backend Settings
RUN_TESTS_ON_STARTUP=false
AUTO_START_SCRAPERS=false
SCRAPER_HEADLESS=false
IEEE_MAX_ARTICLES=100
SCIENCEDIRECT_MAX_ARTICLES=100
ACM_MAX_ARTICLES=100
WILEY_MAX_ARTICLES=100
SPRINGER_MAX_ARTICLES=100

# Enabled Scrapers (comma separated: ieee,sciencedirect,acm)
# ieee: Sadece IEEE Xplore scraper çalışır
# sciencedirect: Sadece ScienceDirect scraper çalışır
# acm: Sadece ACM Digital Library scraper çalışır
# ieee,sciencedirect,acm: Tüm scraper'lar çalışır
ENABLED_SCRAPERS=ieee,sciencedirect

# Scraper Run Mode
# parallel: Scraper'lar aynı anda çalışır (5 sn arayla başlar)
# sequential: Scraper'lar sırayla çalışır (biri bitince diğeri başlar)
# round_robin: Her 3 journalda bir diğer siteye geçilir (döngüsel: IEEE -> SD -> IEEE -> ...)
SCRAPER_RUN_MODE=round_robin

# Round Robin Settings (only for round_robin mode)
ROUND_ROBIN_JOURNALS_PER_SWITCH=1

# NLP/Clustering Settings
# true: Önce PKL dosyasını kullan, yoksa DB'ye bak
# false: Önce DB'ye bak, yoksa PKL'yi dene
NLP_PREFER_PKL=true
NLP_MODEL_PATH=analyzer/clustering_model_.pkl
NLP_MODEL_VERSION=v1.0
NLP_MODEL_DIR=nlp_models
NLP_EMBEDDER_MODEL=allenai/aspire-sentence-embedder
NLP_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLP_UMAP_N_NEIGHBORS=15
NLP_UMAP_N_COMPONENTS=10
NLP_MIN_CLUSTER_SIZE=20
NLP_MIN_SAMPLES=1
# NLP modelleri başlangıçta değil ilk kullanımda yüklensin mi
NLP_LAZY_INIT=true

# Redis Cache Settings
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6440/0
REDIS_PREFIX=academic

# Cache TTL Settings (saniye)
CACHE_TTL_ARTICLE=3600
CACHE_TTL_JOURNAL=21600
CACHE_TTL_ISSUE=7200
CACHE_TTL_CLUSTER=1800
CACHE_TTL_SEARCH=900
CACHE_TTL_STATS=300

# Prefetch Settings
PREFETCH_ENABLED=true
PREFETCH_ARTICLES_PER_ISSUE=20
PREFETCH_ISSUES_PER_JOURNAL=3
PREFETCH_ARTICLES_PER_CLUSTER=50
PREFETCH_NEIGHBOR_CLUSTERS=1
PREFETCH_NEIGHBOR_ISSUES=1
PREFETCH_NEIGHBOR_ARTICLES_LIMIT=20

# ==================== Elasticsearch ====================
ELASTICSEARCH_AUTO_SYNC=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=academic

# ==================== API / Backend Settings ====================
DEBUG=false
CORS_ORIGINS=["*"]
LOG_FORMAT=pretty

# ==================== Scraper Wait Settings ====================
IEEE_MIN_WAIT=4
IEEE_MAX_WAIT=10
IEEE_PAGE_LOAD_TIMEOUT=90
SD_TIMEOUT=90
SD_IMPLICIT_WAIT=90
ACM_MIN_WAIT=4
ACM_MAX_WAIT=10
ACM_PAGE_LOAD_TIMEOUT=90
WILEY_MIN_WAIT=4
WILEY_MAX_WAIT=10
WILEY_PAGE_LOAD_TIMEOUT=90
SPRINGER_MIN_WAIT=3
SPRINGER_MAX_WAIT=8
SPRINGER_PAGE_LOAD_TIMEOUT=60

# ==================== Slow-Network / Resilience Settings ====================
# Yavaş/dengesiz internet optimizasyonu. Tüm scraper'lara uygulanır.
#
# Sayfa yükleme stratejisi: normal | eager | none
#   eager = DOMContentLoaded'da devam (görseller/subresource beklenmez) — önerilen
PAGE_LOAD_STRATEGY=eager
IMPLICIT_WAIT=5
MAX_PAGE_LOAD_TIMEOUT_CAP=240

# Kaynak engelleme (görsel/font/medya inmesin → yavaş hatta büyük bant kazancı)
BLOCK_RESOURCES=True
BLOCK_IMAGES=True
BLOCK_FONTS=True
BLOCK_MEDIA=True
# CSS engelleme RİSKLİ (anti-bot/JS görünürlüğünü bozabilir) — varsayılan kapalı
BLOCK_STYLESHEETS=False
# Per-scraper override (boş = BLOCK_RESOURCES kullanılır): True/False
# IEEE_BLOCK_RESOURCES=
# SCIENCEDIRECT_BLOCK_RESOURCES=
# ACM_BLOCK_RESOURCES=
# WILEY_BLOCK_RESOURCES=
# SPRINGER_BLOCK_RESOURCES=
BLOCKED_URL_PATTERNS=*doubleclick.net*,*googlesyndication.com*,*google-analytics.com*,*googletagmanager.com*,*scorecardresearch.com*,*hotjar.com*,*segment.io*,*facebook.net*,*adservice.google.com*

# Ağ hızı probe — page-load timeout'unu ölçülen gecikmeye göre ölçekler
NET_PROBE_URL=https://www.google.com/generate_204
NET_SLOW_LATENCY_MS=800
NET_VERY_SLOW_LATENCY_MS=2500
NET_SLOW_MULTIPLIER=2.0
NET_VERY_SLOW_MULTIPLIER=3.5

# Adaptif eşzamanlılık (yavaş/dengesiz hatta worker havuzunu küçült/büyüt — AIMD)
ADAPTIVE_CONCURRENCY_ENABLED=True
ADAPTIVE_MIN_TABS=1
ADAPTIVE_MAX_TABS=6
ADAPTIVE_WINDOW=12
ADAPTIVE_ERROR_HI=0.35
ADAPTIVE_ERROR_LO=0.10
ADAPTIVE_COOLDOWN_FETCHES=8

# Per-scraper paralel worker (tab) sayısı
IEEE_MAX_TABS=3
SCIENCEDIRECT_MAX_TABS=3
ACM_MAX_TABS=3
WILEY_MAX_TABS=3
SPRINGER_MAX_TABS=3

# Retry / Circuit Breaker (resilient_fetch)
RETRY_MAX=3
RETRY_BACKOFF_BASE=1.5
RETRY_BACKOFF_CAP=30
PARTIAL_PAGE_RECOVERY_ENABLED=True
CB_FAILURE_THRESHOLD=8
CB_RECOVERY_TIMEOUT=180

# Yavaş ağ simülasyonu (YALNIZCA test/doğrulama — üretimde False bırakın)
# True iken CDP ile ~2G/3G koşulu emüle edilir; ON/OFF metrik kıyası için
SCRAPER_NET_EMULATE=False
SCRAPER_NET_EMULATE_LATENCY_MS=400
SCRAPER_NET_EMULATE_DOWNLOAD_BPS=51200
SCRAPER_NET_EMULATE_UPLOAD_BPS=20480

# ==================== PDF Download Settings ====================
PDF_DOWNLOAD_TIMEOUT=60
PDF_DOWNLOAD_CHUNK_SIZE=8192

# ==================== Redis Streams ====================
REDIS_STREAMS_ENABLED=true
REDIS_STREAMS_CONSUMER_GROUP=academic-backend
REDIS_STREAMS_DLQ_RETRY_INTERVAL=300
